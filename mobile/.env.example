# Same Supabase project as the web app — this app reads the same database,
# under the same RLS policies, as the signed-in user.
# From: https://app.supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The deployed Next.js app. Used for POST /api/search (and, later, watch
# creation) — those routes hold server-side secrets (SERPAPI_KEY, etc.) this
# app must never have, so it calls them over HTTPS instead of duplicating
# that logic. See lib/api.ts.
EXPO_PUBLIC_API_BASE_URL=https://as-price-watcher.vercel.app
