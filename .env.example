# ── Supabase ──────────────────────────────────────────────────────────
# From: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose to browser

# ── Amadeus ───────────────────────────────────────────────────────────
# Free account: https://developers.amadeus.com
# Create an app → get Client ID + Secret
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
AMADEUS_ENV=test   # Change to "production" after going live

# ── Resend (email alerts) ─────────────────────────────────────────────
# Free: https://resend.com — 3,000 emails/month
RESEND_API_KEY=re_your-api-key
ALERT_FROM_EMAIL=alerts@yourdomain.com   # Must be a verified domain in Resend

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Change to your Vercel URL in prod

# ── Cron security ─────────────────────────────────────────────────────
# Any long random string — set the same value in Vercel env vars
# The cron endpoint checks: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-secret-here
