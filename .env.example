# ── Supabase ──────────────────────────────────────────────────────────
# From: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose to browser

# ── SerpApi — CASH prices (required) ──────────────────────────────────
# Free account: https://serpapi.com — 250 searches/month, no card needed
SERPAPI_KEY=your-serpapi-key
# true = return no price rather than falling back to a non-Alaska carrier
SERPAPI_STRICT_AS=false

# ── seats.aero — MILES prices (OPTIONAL) ──────────────────────────────
# Requires a seats.aero Pro subscription (~$9.99/mo) → Settings → API.
# Leave blank to disable miles tracking; cash tracking is unaffected.
SEATS_AERO_KEY=
SEATS_AERO_SOURCES=alaska

# ── Search quota guard ────────────────────────────────────────────────
# Each day in a search range costs one SerpApi search. Keep this small.
#
# NEXT_PUBLIC_ because the homepage reads it too, to show what a search will
# cost before you run it. Not a secret — the API route enforces the cap
# server-side regardless of what any client believes.
NEXT_PUBLIC_SEARCH_MAX_DAYS=5

# ── Alert noise guards (ALL OPTIONAL) ─────────────────────────────────
# Defaults are baked into lib/alerts.ts — leave these commented out and the
# values below apply. Uncomment only to override, then redeploy (they are
# read at module load, not per request).
#
# Why they exist: "new all-time low" with only 2 checks on record means
# "cheaper than the one other time we looked", so a $2 dip on a $609 fare
# would fire an alert. Same for the 7-day average when it has one data point.
#
# Minimum total checks before ANY alert can fire.
# Higher = less noise, but longer blind period on a daily cron.
# ALERT_MIN_CHECKS=5
#
# A new low must beat the previous low by at least this fraction (0.02 = 2%).
# Stops trivial dips from counting as an all-time low.
# ALERT_NEW_LOW_MARGIN=0.02
#
# Minimum data points inside the 7-day window for the average to be used.
# ALERT_MIN_WINDOW=3

# ── Resend (email alerts) ─────────────────────────────────────────────
# Free: https://resend.com — 3,000 emails/month
RESEND_API_KEY=re_your-api-key
#
# Two options for the sender:
#
# 1. onboarding@resend.dev — no domain, no DNS, works immediately, BUT it
#    only delivers to the email address that OWNS the Resend account.
#    Register the Resend account with the same address your app user logs
#    in with, or every send returns 403 while looking correctly configured.
#    Fine while you are the only user. <-- current setup
#
# 2. An address at a domain you have verified in Resend. Required before
#    anyone else can receive alerts. Swapping is just this one line.
#
ALERT_FROM_EMAIL=onboarding@resend.dev

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Change to your Vercel URL in prod

# ── Cron security ─────────────────────────────────────────────────────
# Any long random string — set the same value in Vercel env vars
# The cron endpoint checks: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-secret-here
